          SELECT TOP(1) [o].[Id], [o].[BranchId], [o].[ClientAddressId], [o].[ClientId], [o].[CreatedAt], [o].[CurrentStatus], [o].[Discount], [o].[IsDeleted], [o].[LastDriverAccuracyMeters], [o].[LastDriverHeadingDegrees], [o].[LastDriverLatitude], [o].[LastDriverLocationAtUtc], [o].[LastDriverLongitude], [o].[LastDriverSpeedMetersPerSecond], [o].[LastDriverUserId], [o].[Note], [o].[OrderDate], [o].[PaymentMethod], [o].[TotalAmount], [o].[TrackingNumber], [o].[UpdatedAt], [t].[Id] AS [Id0], [t].[BranchId] AS [BranchId0], [t].[CreatedAt] AS [CreatedAt0], [t].[Email], [t].[EmailVerificationCodeExpiresAt], [t].[EmailVerificationCodeHash], [t].[EmailVerificationFailedAttempts], [t].[EmailVerificationLastSentAt], [t].[IsDeleted] AS [IsDeleted0], [t].[IsEmailVerified], [t].[LastLoginAt], [t].[LastName], [t].[Name], [t].[PasswordHash], [t].[Phone], [t].[UpdatedAt] AS [UpdatedAt0], [t0].[Id] AS [Id1], [t0].[AccentColor], [t0].[Address], [t0].[BillingEmail], [t0].[BrandName], [t0].[City], [t0].[ClosingHour], [t0].[Country], [t0].[CreatedAt] AS [CreatedAt1], [t0].[DayClosingHour], [t0].[DayOpeningHour], [t0].[DayShiftEnabled], [t0].[HomePage], [t0].[IsDeleted] AS [IsDeleted1], [t0].[LogoUrl], [t0].[MembershipPlan], [t0].[MembershipStatus], [t0].[MonthlyOrderLimit], [t0].[Name] AS [Name0], [t0].[NightClosingHour], [t0].[NightOpeningHour], [t0].[NightShiftEnabled], [t0].[OpeningHour], [t0].[Phone] AS [Phone0], [t0].[PostalCode], [t0].[PrimaryColor], [t0].[PublicDescription], [t0].[PublicOrderingEnabled], [t0].[Region], [t0].[SecondaryColor], [t0].[Slug], [t0].[TenantFolder], [t0].[TimeZoneId], [t0].[TrialEndsAt], [t0].[UpdatedAt] AS [UpdatedAt1]
          FROM [Orders] AS [o]
          LEFT JOIN (
              SELECT [c].[Id], [c].[BranchId], [c].[CreatedAt], [c].[Email], [c].[EmailVerificationCodeExpiresAt], [c].[EmailVerificationCodeHash], [c].[EmailVerificationFailedAttempts], [c].[EmailVerificationLastSentAt], [c].[IsDeleted], [c].[IsEmailVerified], [c].[LastLoginAt], [c].[LastName], [c].[Name], [c].[PasswordHash], [c].[Phone], [c].[UpdatedAt]
              FROM [Clients] AS [c]
              WHERE [c].[IsDeleted] = CAST(0 AS bit) AND (@__ef_filter__p_0 = CAST(1 AS bit) OR [c].[BranchId] = @__ef_filter__CurrentBranchId_1)
          ) AS [t] ON [o].[ClientId] = [t].[Id]
          INNER JOIN (
              SELECT [b].[Id], [b].[AccentColor], [b].[Address], [b].[BillingEmail], [b].[BrandName], [b].[City], [b].[ClosingHour], [b].[Country], [b].[CreatedAt], [b].[DayClosingHour], [b].[DayOpeningHour], [b].[DayShiftEnabled], [b].[HomePage], [b].[IsDeleted], [b].[LogoUrl], [b].[MembershipPlan], [b].[MembershipStatus], [b].[MonthlyOrderLimit], [b].[Name], [b].[NightClosingHour], [b].[NightOpeningHour], [b].[NightShiftEnabled], [b].[OpeningHour], [b].[Phone], [b].[PostalCode], [b].[PrimaryColor], [b].[PublicDescription], [b].[PublicOrderingEnabled], [b].[Region], [b].[SecondaryColor], [b].[Slug], [b].[TenantFolder], [b].[TimeZoneId], [b].[TrialEndsAt], [b].[UpdatedAt]
              FROM [Branches] AS [b]
              WHERE [b].[IsDeleted] = CAST(0 AS bit)
          ) AS [t0] ON [o].[BranchId] = [t0].[Id]
          WHERE [o].[IsDeleted] = CAST(0 AS bit) AND (@__ef_filter__p_0 = CAST(1 AS bit) OR [o].[BranchId] = @__ef_filter__CurrentBranchId_1) AND [o].[TrackingNumber] = @__trackingNumber_0
      ) AS [t1]
      LEFT JOIN (
          SELECT [o0].[Id], [o0].[CreatedAt], [o0].[Discount], [o0].[IsDeleted], [o0].[Observation], [o0].[OrderId], [o0].[ProductId], [o0].[Quantity], [o0].[UnitPrice], [o0].[UpdatedAt], [t4].[Id] AS [Id0], [t4].[BranchId], [t4].[CategoryId], [t4].[CreatedAt] AS [CreatedAt0], [t4].[Description], [t4].[ImageUrl], [t4].[IsActive], [t4].[IsDeleted] AS [IsDeleted0], [t4].[Name], [t4].[Price], [t4].[UpdatedAt] AS [UpdatedAt0], [t3].[Id] AS [Id1]
          FROM [OrderItems] AS [o0]
          INNER JOIN (
              SELECT [o1].[Id], [o1].[BranchId]
              FROM [Orders] AS [o1]
              WHERE [o1].[IsDeleted] = CAST(0 AS bit) AND (@__ef_filter__p_0 = CAST(1 AS bit) OR [o1].[BranchId] = @__ef_filter__CurrentBranchId_1)
          ) AS [t3] ON [o0].[OrderId] = [t3].[Id]
          INNER JOIN (
              SELECT [p].[Id], [p].[BranchId], [p].[CategoryId], [p].[CreatedAt], [p].[Description], [p].[ImageUrl], [p].[IsActive], [p].[IsDeleted], [p].[Name], [p].[Price], [p].[UpdatedAt]
              FROM [Products] AS [p]
              WHERE [p].[IsDeleted] = CAST(0 AS bit) AND (@__ef_filter__p_0 = CAST(1 AS bit) OR [p].[BranchId] = @__ef_filter__CurrentBranchId_1)
          ) AS [t4] ON [o0].[ProductId] = [t4].[Id]
          WHERE @__ef_filter__p_0 = CAST(1 AS bit) OR [t3].[BranchId] = @__ef_filter__CurrentBranchId_1
      ) AS [t2] ON [t1].[Id] = [t2].[OrderId]
      ORDER BY [t1].[Id], [t1].[Id0], [t1].[Id1], [t2].[Id], [t2].[Id1]
